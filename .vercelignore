# Keep Vercel uploads small — large mesh libraries live on R2 (assets.grudge-studio.com)
server/node_modules
server/dist
artifacts/api-server/node_modules
artifacts/api-server/dist
artifacts/animator/node_modules
legacy-static
client/public/assets
scripts/upload-r2.mjs
Dockerfile
nixpacks.toml
railway.json
.env*
**/*.br
**/*.gz

# Local staged models (R2/D1 SSOT — never ship multi-GB binaries in deploy tarball)
artifacts/animator/public/models/voxel/**
artifacts/animator/public/models/voxel-only/**
artifacts/animator/public/models/warlords-era/**
artifacts/animator/public/models/worlds/**
artifacts/animator/public/models/battle/**
artifacts/animator/public/models/packs/**
# Tropical island only (~70MB×2) — other Danger maps ship with SPA (see exceptions below)
artifacts/animator/public/models/maps/tropical/**
artifacts/animator/public/models/kenney/**
artifacts/animator/public/models/**/*.glb
artifacts/animator/public/models/**/*.fbx

# Ban GLB/FBX by default (keeps multi-GB model trees out of the deploy tarball)
**/*.glb
**/*.fbx
**/*.rar
**/*.zip

# EXCEPTION: Explorer Mixamo production packs ONLY (not authoring dumps).
