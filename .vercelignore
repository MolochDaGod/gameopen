# Keep Vercel uploads small — large mesh libraries live on R2 (assets.grudge-studio.com)
server/node_modules
server/dist
artifacts/api-server/node_modules
artifacts/api-server/dist
artifacts/animator/node_modules
legacy-static
client/public/assets
scripts/upload-r2.mjs
Dockerfile
nixpacks.toml
railway.json
.env*
**/*.br
**/*.gz

# Local staged models (R2/D1 SSOT — never ship multi-GB binaries in deploy tarball)
artifacts/animator/public/models/voxel/**
artifacts/animator/public/models/voxel-only/**
artifacts/animator/public/models/warlords-era/**
artifacts/animator/public/models/worlds/**
artifacts/animator/public/models/battle/**
artifacts/animator/public/models/packs/**
# Tropical island only (~70MB×2) — other Danger maps ship with SPA (see exceptions below)
artifacts/animator/public/models/maps/tropical/**
artifacts/animator/public/models/kenney/**
artifacts/animator/public/models/**/*.glb
artifacts/animator/public/models/**/*.fbx

# Ban GLB/FBX by default (keeps multi-GB model trees out of the deploy tarball)
# Historical deploys that bundled local kits caused SI stretch vs CDN SSOT.
**/*.glb
**/*.fbx
**/*.obj
**/*.blend
**/*.tga
**/*.tif
**/*.tiff
**/*.psd
**/*.rar
**/*.zip
**/*.7z

# Never ship author/source character kits or cinema stage dumps in SPA
**/grudge6/**
**/Toon*/**
**/tpose-for-mixamo/**
**/public/models/cinema/**
**/public/models/grudge6/**
**/node_modules/**
**/.git/**
**/backups/**
**/reports/**
**/artifacts/animator/public/models/nature/**
**/artifacts/animator/public/models/characters/**

# EXCEPTION: Explorer Mixamo + Layer-A base pack under public/anim MUST ship.
# Without these, open.grudge-studio.com/dressing loads a procedural skeleton with
# zero mixer clips → permanent T-pose (probed: /anim/** 404 on production).
!artifacts/animator/public/anim/
!artifacts/animator/public/anim/**
!artifacts/animator/public/anim/**/*.glb
!artifacts/animator/public/anim/**/*.fbx

# EXCEPTION: Danger Room practice dummy + boss tester (~0.5 MB total).
# Served same-origin under /ui/training-targets (not /models/props → R2 rewrite).
!artifacts/animator/public/ui/training-targets/
!artifacts/animator/public/ui/training-targets/**
!artifacts/animator/public/ui/training-targets/**/*.glb
!artifacts/animator/dist/public/ui/training-targets/
!artifacts/animator/dist/public/ui/training-targets/**
!artifacts/animator/dist/public/ui/training-targets/**/*.glb

# EXCEPTION: Danger Room outdoor maps + wing (parent dirs must not be fully ignored —
# maps/** ban was removed for that reason; only tropical/** stays banned).
!artifacts/animator/public/models/maps/shipwreck/
!artifacts/animator/public/models/maps/shipwreck/**
!artifacts/animator/public/models/maps/shipwreck/**/*.glb
!artifacts/animator/public/models/maps/forest_mountains/
!artifacts/animator/public/models/maps/forest_mountains/**
!artifacts/animator/public/models/maps/forest_mountains/**/*.glb
!artifacts/animator/public/models/maps/arena/
!artifacts/animator/public/models/maps/arena/**
!artifacts/animator/public/models/maps/arena/**/*.glb
!artifacts/animator/public/models/maps/pirate/
!artifacts/animator/public/models/maps/pirate/**
!artifacts/animator/public/models/maps/pirate/**/*.glb
!artifacts/animator/public/models/equipment/
!artifacts/animator/public/models/equipment/wing_animated.glb
# Danger Room: Racalvin disc_jockey show + climbingwall hold mesh
!artifacts/animator/public/models/dj/
!artifacts/animator/public/models/dj/**
!artifacts/animator/public/models/dj/**/*.glb
!artifacts/animator/public/models/maps/climbing/
!artifacts/animator/public/models/maps/climbing/**
!artifacts/animator/public/models/maps/climbing/**/*.glb
!artifacts/animator/dist/public/models/dj/
!artifacts/animator/dist/public/models/dj/**
!artifacts/animator/dist/public/models/dj/**/*.glb
!artifacts/animator/dist/public/models/maps/climbing/
!artifacts/animator/dist/public/models/maps/climbing/**
!artifacts/animator/dist/public/models/maps/climbing/**/*.glb
