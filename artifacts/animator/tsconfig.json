{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/grudge-physics": ["../../lib/grudge-physics/src/index.ts"],
      "@workspace/api-client-react": ["../../lib/api-client-react/src/index.ts"],
      "@workspace/api-zod": ["../../lib/api-zod/src/index.ts"],
      "@workspace/danger-net": ["../../lib/danger-net/src/index.ts"],
      "@workspace/epicfight": ["../../lib/epicfight/src/index.ts"],
      "@workspace/carrier-net": ["../../lib/carrier-net/src/index.ts"],
      "@workspace/brawl-net": ["../../lib/brawl-net/src/index.ts"],
      "@workspace/voxel-canonical": ["../../lib/voxel-canonical/src/index.ts"],
      "@workspace/grudge-runtime": ["../../lib/grudge-runtime/src/index.ts"],
      "@workspace/grudge-warlords": ["../../lib/grudge-warlords/src/index.ts"],
      "@workspace/vfx": ["../../lib/vfx/src/index.ts"],
      "@workspace/vfx/footAuraCatalog": ["../../lib/vfx/src/footAuraCatalog.ts"],
      "@workspace/animator": ["../../lib/animator/src/index.ts"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    },
    {
      "path": "../../lib/epicfight"
    }
  ]
}
