{
  "name": "Grudge Open",
  "short_name": "Grudge Open",
  "description": "Steam-style fleet launcher — library, Danger Room, Mine-Loader Realms, Warlords handoff, installable desktop/mobile app. Shared Grudge ID + Railway characters.",
  "id": "/",
  "start_url": "/?door=library",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#060a12",
  "theme_color": "#171a21",
  "lang": "en",
  "dir": "ltr",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.ico",
      "sizes": "16x16 32x32 48x48",
      "type": "image/x-icon",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/opengraph.jpg",
      "sizes": "1200x630",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Grudge Open library"
    },
    {
      "src": "/rooms/library-danger-scene.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Danger Room combat"
    }
  ],
  "shortcuts": [
    {
      "name": "Game Library",
      "short_name": "Library",
      "description": "Browse fleet games",
      "url": "/?door=library",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Danger Room",
      "short_name": "Danger",
      "description": "Combat sandbox",
      "url": "/?door=danger",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Account",
      "short_name": "Account",
      "description": "Characters · wallet · treaty",
      "url": "/?door=account",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mine-Loader Realms",
      "short_name": "Realms",
      "description": "Multiplayer worlds",
      "url": "/?door=library",
      "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  }
}
