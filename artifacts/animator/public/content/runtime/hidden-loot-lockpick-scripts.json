    {
      "id": "script_hidden_treasure_demo",
      "name": "Hidden treasure lockpick",
      "mode": "repeat",
      "enabled": true,
      "tags": ["loot", "lockpick", "hidden_treasure"],
      "trigger": {
        "kind": "interact",
        "targetId": "prop_hidden_treasure"
      },
      "actions": [
        {
          "kind": "open-ui",
          "payload": {
            "ui": "lockpick",
            "targetId": "treasure:prop_hidden_treasure",
            "kind": "hidden_treasure",
            "difficulty": 48,
            "label": "Hidden treasure"
          }
        }
      ]
    },
    {
      "id": "script_foreign_camp_steal",
