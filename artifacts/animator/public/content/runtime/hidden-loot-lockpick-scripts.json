{
  "id": "hidden-loot-lockpick",
  "name": "Lockpick zones — NOT home island (safe)",
  "version": 2,
  "notes": "Home islands never get lockpick scripts. Dungeons, treasures, contested, enemy, conquered, foreign camp only.",
  "scripts": [
    {
      "id": "script_dungeon_chest",
      "name": "Dungeon chest lockpick",
      "mode": "repeat",
      "enabled": true,
      "tags": ["loot", "lockpick", "dungeon"],
      "trigger": { "kind": "interact", "targetId": "prop_dungeon_chest" },
      "actions": [
        {
          "kind": "open-ui",
          "payload": {
            "ui": "lockpick",
            "targetId": "dungeon:prop_dungeon_chest",
            "kind": "dungeon_chest",
            "zone": "dungeon",
            "difficulty": 35,
            "label": "Dungeon chest"
          }
        }
      ]
    },
