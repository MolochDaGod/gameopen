{
  "version": 1,
  "updated": "2026-07-25",
  "description": "When a weapon is equipped, which baked anim pack is LIVE (and role contract). Fallbacks keep combat playable when pack bake is incomplete.",
  "policy": {
    "preferredHost": "same-origin",
    "bakeRoot": "anims/baked",
    "prodAnimsRoot": "prod/anims",
    "prodAnimsCdn": "https://assets.grudge-studio.com/prod/anims",
    "mixamoRoot": "anim",
    "integrity": "sha256",
    "stripPositionTracks": true,
    "skeleton": "Bip001",
    "notes": [
      "Danger heroes: preset mesh_ids only (gear preset weapons) — load baked anims for that weapon family, never equip extra weapon meshes at runtime.",
      "Equip weaponId → animPack (live). Runtime loads only that pack's loco+attack+skills + shared traversal (climb/swim/dodge/roll/harvest/block).",
      "If pack missing/incomplete, use fallbackPack (still Bip001 baked) then prod/anims CDN.",
      "Mixamo public/anim/* is authoring source — not live on Vercel (.vercelignore **/*.fbx). Ship baked JSON or prod/anims GLB libraries.",
      "Never load locomotion/running (banned run-to-roll)."
    ]
  },
  "sharedTraversal": {
    "pack": "traversal",
    "roles": {
      "jump": "locomotion/jump",
      "dodge": "locomotion/dodge_back",
      "dodgeF": "locomotion/dodge_fwd",
      "dodgeL": "locomotion/dodge_l",
      "dodgeR": "locomotion/dodge_r",
      "roll": "roll_dodge/dodging-back",
      "crawl": "locomotion/crawl",
      "swim": "locomotion/swim",
      "swimFast": "locomotion/swim_fast",
      "tread": "swim/treading",
      "climb": "locomotion/climbup_1m",
      "climbUp": "climb/up",
      "mantle": "climb/to_top",
      "hang": "climb/hang_idle",
      "wallRun": "climb/wall_run",
      "harvest": "locomotion/plant_seed",
      "block": "block/standing-block-idle",
      "parry": "block/parry"
    },
    "alwaysLoadWithWeapon": true,
    "notes": [
      "Sprint is NOT a bake path — clone pack.run + SPRINT_LOCO_MULT. locomotion/running is BANNED run-to-roll.",
      "crawl/climb/swim Mixamo under public/anim/* → bake to anims/baked/* before production."
    ]
  },
  "roleContract": {
    "required": ["idle", "walk", "run", "attack"],
    "recommended": ["sprint", "jump", "dodge", "skill1", "skill2", "skill3", "skill4"],
    "optional": ["hurt", "death", "block", "parry", "cast", "crawl", "swim", "climb", "mantle", "hang"],
    "neverAliasToAttack": ["jump", "dodge", "roll", "sprint", "crawl", "swim", "climb", "hurt", "death", "block", "parry"]
  },
  "namingCorrections": {
    "locomotion/running": "BANNED — run-to-roll transition, not sprint",
    "sprint": "Runtime role only: clone of verified run cycle × 1.75 timeScale",
    "polearm/run": "Do not use as gait — Madarame full take ~5s; use locomotion/run_forward",
    "locomotion/walking": "BANNED tip/fall on Arena GLB kits — use Standing Walk Forward",
    "sword_shield/sword and shield run": "BANNED thin arena gait — use samurai run_sword or locomotion/run_forward",
    "2h_melee/*": "Incomplete pack purged — dual_wield / samurai are production soft fallbacks"
  },
