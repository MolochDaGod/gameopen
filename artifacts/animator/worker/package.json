{
  "name": "anim-ai-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained Cloudflare Worker for the Animator AI skeleton mover (AI generation + D1/R2 clip storage). Deployed by the end user; NOT part of the Replit monorepo.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute anim_clips --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute anim_clips --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.9.0",
    "wrangler": "^3.78.0"
  }
}
